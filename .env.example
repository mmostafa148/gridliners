# Canonical origin used by metadata and generated social images.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Adobe Fonts kit that provides the Presicav display family.
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=onq1ytv

# Replace with a long random value in every shared or deployed environment.
MOCK_SESSION_SECRET=replace-with-a-long-random-value

# Optional demo controls.
NEXT_PUBLIC_MOCK_PERSIST=0
NEXT_PUBLIC_MOCK_LATENCY=0
NEXT_PUBLIC_MOCK_ERROR_RATE=0
NEXT_PUBLIC_ENABLE_DEV_ROUTES=0

# Optional: keep verification builds separate from the development output.
# NEXT_DIST_DIR=.next-verify
